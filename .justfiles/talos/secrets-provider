#!/usr/bin/env bash
# topf secretsProvider: serves the Talos secrets bundle straight out of
# 1Password, so nothing secret ever lands in the repo (no SOPS).
#
# Contract (https://postfinance.github.io/topf/main/providers/):
#   <binary> secrets get <clusterName>   -> bundle YAML on stdout
#   <binary> secrets put <clusterName>   <- bundle YAML on stdin
#
# `get` renders talsecret.yaml (${talos_*} placeholders) with the op.env
# references resolved for the requested cluster. `put` is refused on purpose:
# the bundle is only ever created once per cluster and lives in 1Password.
#
# 1Password setup (jory's style):
#   - Single item named `talos` in the Kubernetes vault
#   - Per-cluster fields: {cluster}_id, {cluster}_secret, {cluster}_certs_*, etc.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-} ${2:-}" in
  "secrets get")
    cluster="${3:?cluster name required}"
    VAULT="${VAULT:-Kubernetes}" CLUSTER="$cluster" \
      op run --env-file="$here/op.env" --no-masking -- \
      envsubst < "$here/talsecret.yaml"
    ;;
  "secrets put")
    echo "refusing to write a new secrets bundle: store it in 1Password as <cluster>-talos" >&2
    exit 1
    ;;
  *)
    echo "usage: $0 secrets get|put <clusterName>" >&2
    exit 2
    ;;
esac
